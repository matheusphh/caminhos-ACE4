# Valores para desenvolvimento local; configure credenciais fortes no servidor.
POSTGRES_DB=bdgd
POSTGRES_USER=bdgd
POSTGRES_PASSWORD=troque-por-uma-senha-forte
BDGD_REFERENCE_DATE=2025-12-31
CORS_ORIGINS=http://localhost:8001,https://matheusphh.github.io
# URL de conexão Postgres do Supabase (somente backend/importador; nunca no frontend).
SUPABASE_DATABASE_URL=
# Porta local opcional para expor a API conectada ao Supabase.
SUPABASE_API_PORT=8000
# Caminho dentro de ./dados para o arquivo .gdb baixado da ANEEL.
BDGD_GDB=/data/BDGB.gdb
